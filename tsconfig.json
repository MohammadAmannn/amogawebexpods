{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@amoga/theme": [
        "./packages/theme/index.ts"
      ],
      "@amoga/theme/*": [
        "./packages/theme/*"
      ],
      "@amoga/auth": [
        "./packages/auth/index.ts"
      ],
      "@amoga/auth/*": [
        "./packages/auth/*"
      ],
      "@amoga/api": [
        "./packages/api/index.ts"
      ],
      "@amoga/api/*": [
        "./packages/api/*"
      ],
      "@amoga/types": [
        "./packages/types/index.ts"
      ],
      "@amoga/types/*": [
        "./packages/types/*"
      ],
      "@amoga/schemas": [
        "./packages/schemas/index.ts"
      ],
      "@amoga/schemas/*": [
        "./packages/schemas/*"
      ],
      "@amoga/config": [
        "./packages/config/index.ts"
      ],
      "@amoga/config/*": [
        "./packages/config/*"
      ],
      "@amoga/permissions": [
        "./packages/permissions/index.ts"
      ],
      "@amoga/permissions/*": [
        "./packages/permissions/*"
      ],
      "@amoga/state": [
        "./packages/state/index.ts"
      ],
      "@amoga/state/*": [
        "./packages/state/*"
      ],
      "@amoga/utils": [
        "./packages/utils/index.ts"
      ],
      "@amoga/utils/*": [
        "./packages/utils/*"
      ],
      "@amoga/storage": [
        "./packages/storage/index.ts"
      ],
      "@amoga/storage/*": [
        "./packages/storage/*"
      ],
      "@amoga/chat": [
        "./packages/chat/index.ts"
      ],
      "@amoga/chat/*": [
        "./packages/chat/*"
      ],
      "@amoga/analytics": [
        "./packages/analytics/index.ts"
      ],
      "@amoga/analytics/*": [
        "./packages/analytics/*"
      ],
      "@amoga/observability": [
        "./packages/observability/index.ts"
      ],
      "@amoga/observability/*": [
        "./packages/observability/*"
      ],
      "@amoga/ui": [
        "./packages/ui/index.ts"
      ],
      "@amoga/ui/*": [
        "./packages/ui/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
